# Copy this file to .env (never commit .env) and fill in your own values.
# On a host (Vercel, Cloudflare, etc.) set the same names in its environment-variable settings.

# --- Browser-safe (VITE_ values are public in the built site) -----------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STORE_NAME=Vitrine
VITE_STORE_CURRENCY=KES
VITE_CARD_PAYMENTS_ENABLED=false

# --- SERVER ONLY: never put these in a VITE_ variable and never commit real values --------------
SUPABASE_SERVICE_ROLE_KEY=
NOTIFICATIONS_RUN_TOKEN=            # 16+ random characters

# M-Pesa (Daraja sandbox)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=            # https://your-public-site.com
MPESA_CALLBACK_TOKEN=               # 16+ random characters
MPESA_RECONCILE_TOKEN=              # 16+ random characters

# Card gateway (only if you enable card payments)
CARD_PROVIDER_SECRET_KEY=
CARD_WEBHOOK_SECRET=
CARD_RETURN_BASE_URL=
